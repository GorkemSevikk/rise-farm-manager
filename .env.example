# --------------------------------------------------------------------------
# Rise Farm Manager - ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayıp değerleri kendi Firebase
# projenizden alın. .env.local dosyası git'e gönderilmez.
# --------------------------------------------------------------------------

# Demo modu: Firebase olmadan örnek verilerle çalışır.
# Boş bırakırsanız da anahtarlar girilmediği sürece geliştirme ortamında
# otomatik olarak demo moda geçilir. Gerçek verilerle çalışmak için
# aşağıdaki Firebase anahtarlarını doldurmanız yeterlidir.
NEXT_PUBLIC_DEMO_MODE=

# Firebase konsolu > Proje ayarları > Genel > "Web uygulaması" yapılandırması
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=proje-adi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=proje-adi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=proje-adi.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# İlk girişte otomatik yönetici olacak e-postalar (virgülle ayırın).
# Aynı listeyi firestore.rules içindeki isBootstrapAdmin fonksiyonuna da yazın.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAILS=sizin-mailiniz@gmail.com

# --------------------------------------------------------------------------
# Aşağıdakiler yalnızca Discord bildirimleri için gerekir (opsiyonel).
# Firebase konsolu > Proje ayarları > Hizmet hesapları > "Yeni özel anahtar"
# --------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Satır sonlarını \n olarak bırakıp tüm değeri çift tırnak içine alın.
FIREBASE_PRIVATE_KEY=""

# Webhook adresini panelin Ayarlar sayfasından da girebilirsiniz.
# Buradaki değer yedek olarak kullanılır.
DISCORD_WEBHOOK_URL=
