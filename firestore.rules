rules_version = '2';

// Rise Farm Manager - Firestore güvenlik kuralları
//
// Yetki modeli:
//  - admin      : her şeyi yapar; üye onaylar, rol verir, ödeme işaretler, siler.
//  - moderator  : farm ve drop işlemlerini yürütür (yönetici yokken).
//  - member     : hiçbir kayıt oluşturamaz veya değiştiremez; yalnızca okur.
//
// Erişim şartı: kullanıcı dokümanı var + approved == true + active == true.
// Onay bekleyen ve askıya alınmış hesaplar hiçbir veriyi göremez.
//
// Kritik not: pay hesabı (shares/shareGold) tarayıcıda yapılıyor. Bu yüzden
// farm dokümanlarına yazma yetkisi yalnızca güvenilen rollere (admin, moderator)
// verilir. Üyelerin yazma yetkisi tamamen kapalı olduğu için kimse kendi payını
// yükseltemez.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- yardımcılar

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Onaylanmış ve askıya alınmamış hesap. Alanı olmayan eski kayıtlar
    // onaylı sayılır (approved != false), böylece mevcut üyeler kilitlenmez.
    function hasAccess() {
      return hasProfile()
        && userData().approved != false
        && userData().active == true;
    }

    function role() {
      return userData().role;
    }

    function isAdmin() {
      return hasAccess() && role() == 'admin';
    }

    // Yönetici veya yardımcı: kayıt oluşturup değiştirebilen roller.
    function canManage() {
      return hasAccess() && (role() == 'admin' || role() == 'moderator');
    }

    // Kurulum sırasında yönetici olacak e-postalar.
    // NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAILS ile aynı listeyi buraya da yazın.
    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'gorkemsevik2001@gmail.com'
        ];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------- users

    match /users/{userId} {
      // Kendi profilini her zaman okuyabilir (onay bekleyen kullanıcı
      // "onay bekleniyor" ekranını görsün diye). Üye listesi yalnızca
      // yönetici ve yardımcıya açıktır; aksi halde herkes kimin ne
      // kazandığını üye sayfasından çıkarabilir.
      allow read: if isSignedIn()
        && (request.auth.uid == userId || canManage());

      // İlk giriş: kullanıcı yalnızca kendi dokümanını oluşturabilir ve
      // kendini onaylayamaz. Yalnızca kurulum listesindeki e-posta doğrudan
      // yönetici ve onaylı olarak başlar.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.active == true
        && (isBootstrapAdmin()
            ? (request.resource.data.role == 'admin'
               && request.resource.data.approved == true)
            : (request.resource.data.role == 'member'
               && request.resource.data.approved == false));

      // Rol, onay ve aktiflik yalnızca yöneticide. Kullanıcı kendi profil
      // bilgilerini düzenleyebilir ama bu alanlara dokunamaz.
      allow update: if (isAdmin() && request.resource.data.role in ['admin', 'moderator', 'member'])
        || (isSignedIn()
            && request.auth.uid == userId
            && changedKeys().hasOnly([
              'displayName', 'email', 'photoURL', 'nickname',
              'characterClass', 'server', 'discord', 'updatedAt'
            ]));

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- farms

    match /farms/{farmId} {
      // Yönetici ve yardımcı tüm farmları görür. Üye yalnızca katıldığı
      // farmları okuyabilir (sorgular array-contains ile kısıtlanmalı).
      allow read: if canManage()
        || (hasAccess() && request.auth.uid in resource.data.participantIds);
      allow create, update: if canManage();
      // Farm silmek tüm drop ve ödeme geçmişini götürür: yalnızca yönetici.
      allow delete: if isAdmin();

      match /farmParticipants/{participantId} {
        allow read: if canManage()
          || (hasAccess() && request.auth.uid == participantId);
        allow create, update, delete: if canManage();
      }
    }

    // ---------------------------------------------------------------- drops

    match /drops/{dropId} {
      // Drop listesi klanın toplam gelirini ifşa eder; yalnızca kayıt
      // girebilen roller okuyabilir.
      allow read: if canManage();

      allow create: if canManage()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.farmId is string
        && request.resource.data.farmId.size() > 0
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() > 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.estimatedValue is number
        && request.resource.data.estimatedValue >= 0
        && (request.resource.data.soldPrice == null
            || (request.resource.data.soldPrice is number
                && request.resource.data.soldPrice >= 0));

      // farmId ve addedBy hiçbir durumda değişemez: aksi halde bir drop başka
      // bir farmın toplamına kaydırılabilir ya da başkasının adına yazılabilir.
      allow update: if canManage()
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.addedBy == resource.data.addedBy;

      allow delete: if canManage();
    }

    // ---------------------------------------------------------------- payments

    match /payments/{paymentId} {
      // Yönetici ve yardımcı tüm ödeme geçmişini görür; üye yalnızca kendi
      // kayıtlarını. Üye sorguları bu yüzden where("userId","==",uid)
      // filtresi içermek zorundadır.
      allow read: if canManage()
        || (hasAccess() && resource.data.userId == request.auth.uid);

      // Para el değiştirdiğini beyan eden işlem yalnızca yöneticide.
      allow create, update: if isAdmin();

      // Yardımcı bir katılımcıyı farmdan çıkardığında onun ödeme kaydı da
      // silinmek zorunda; aksi halde farmda olmayan birine ait kayıt kalır.
      allow delete: if canManage();
    }

    // ---------------------------------------------------------------- settings

    match /settings/{docId} {
      // 'secrets' dokümanı Discord webhook adresini tutar: yalnızca yönetici.
      allow read: if docId == 'secrets' ? isAdmin() : hasAccess();
      allow write: if isAdmin();
    }
  }
}
